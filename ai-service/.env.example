# Server & Port (Render supplies PORT automatically)
PORT=8000
AI_SERVICE_PORT=8000

# Shared Secret Key between Node.js Backend & Python AI Service
# MUST match AI_SERVICE_API_KEY in my-life-os-backend/.env
AI_SERVICE_API_KEY=my-life-os-ai-internal-key-2026

# OCR Provider: "openai", "groq", or "local" (default: "auto")
OCR_PROVIDER=openai

# OpenAI API Key (for GPT-4o-mini receipt OCR and Whisper STT)
OPENAI_API_KEY=sk-...

# Optional: Model overrides
# OPENAI_VISION_MODEL=gpt-4o-mini

# Optional Fallback: Groq API Key (if ever needed)
# GROQ_API_KEY=
