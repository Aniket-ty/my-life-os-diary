# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# JWT Authentication
JWT_ACCESS_SECRET=your-access-secret-minimum-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary (Receipt & Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Groq AI & Speech-to-text
GROQ_API_KEY=

# AI Gym Equipment Vision Provider (groq | openai | mock)
AI_VISION_PROVIDER=groq
OPENAI_API_KEY=

# Python AI Microservice (FastAPI - Optional, Node has built-in fallbacks)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=my-life-os-ai-internal-key-2026

# OCR Provider Configuration (local | groq | vision)
OCR_PROVIDER=local

# Currency Exchange API
CURRENCY_API_URL=https://open.er-api.com/v6/latest

# Firebase Admin (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
