generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  phoneNumber          String?           @unique @map("phone_number")
  passwordHash         String            @map("password_hash")
  name                 String
  pinHash              String?           @map("pin_hash")
  fcmToken             String?           @map("fcm_token")
  onboardingCompleted  Boolean           @default(false) @map("onboarding_completed")
  age                  Int?
  gender               String?
  heightCm             Decimal?          @map("height_cm") @db.Decimal(5, 1)
  activityLevel        String?           @map("activity_level")
  fitnessGoal          String?           @map("fitness_goal")
  defaultCurrency      String            @default("INR") @map("default_currency")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  chatHistory          ChatMessage[]
  diaryEntries         DiaryEntry[]
  fitnessGoals         FitnessGoal?
  attachments          MediaAttachment[]
  nutritionLogs        NutritionLog[]
  todos                Todo[]
  workouts             Workout[]
  bodyScans            BodyScan[]
  workoutPlans         WorkoutPlan[]
  expenses             Expense[]
  expensesPaid         Expense[]          @relation("ExpensePayer")
  expenseSplits        ExpenseSplit[]
  expenseGroupsCreated ExpenseGroup[]     @relation("GroupCreator")
  groupMemberships     ExpenseGroupMember[]
  settlementsPaid      ExpenseSettlement[] @relation("SettlementPayer")
  settlementsReceived  ExpenseSettlement[] @relation("SettlementPayee")
  receipts             Receipt[]
  notifications        InAppNotification[]
  sentInvites          PendingInvite[]    @relation("InviterUser")
  equipmentScans       EquipmentScanLog[]

  @@map("users")
}

model DiaryEntry {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  title       String?
  content     String
  mood        String?
  weather     String?
  entryDate   DateTime          @map("entry_date") @db.Date
  isPinned    Boolean           @default(false) @map("is_pinned")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments MediaAttachment[]

  @@map("diary_entries")
}

model MediaAttachment {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  entryId       String     @map("entry_id")
  mediaType     MediaType  @map("media_type")
  cloudinaryUrl String     @map("cloudinary_url")
  cloudinaryId  String     @map("cloudinary_id")
  fileName      String?    @map("file_name")
  fileSizeKb    Int?       @map("file_size_kb")
  durationSec   Int?       @map("duration_sec")
  createdAt     DateTime   @default(now()) @map("created_at")
  entry         DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("media_attachments")
}

model Workout {
  id                  String            @id @default(uuid())
  userId              String            @map("user_id")
  name                String
  workoutDate         DateTime          @map("workout_date") @db.Date
  status              WorkoutStatus     @default(planned)
  durationMin         Int?              @map("duration_min")
  notes               String?
  totalCaloriesBurned Int?              @map("total_calories_burned")
  createdAt           DateTime          @default(now()) @map("created_at")
  exercises           WorkoutExercise[]
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workouts")
}

model WorkoutExercise {
  id           String   @id @default(uuid())
  workoutId    String   @map("workout_id")
  exerciseName String   @map("exercise_name")
  sets         Int?
  reps         String?
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 2)
  durationSec  Int?     @map("duration_sec")
  distanceKm   Decimal? @map("distance_km") @db.Decimal(5, 2)
  orderIndex   Int      @default(0) @map("order_index")
  exerciseId   String?  @map("exercise_id")
  workout      Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise     Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@map("workout_exercises")
}

model NutritionLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  foodName    String   @map("food_name")
  mealType    MealType @map("meal_type")
  calories    Int
  proteinG    Decimal? @map("protein_g") @db.Decimal(5, 1)
  carbsG      Decimal? @map("carbs_g") @db.Decimal(5, 1)
  fatG        Decimal? @map("fat_g") @db.Decimal(5, 1)
  quantity    String?
  logDate     DateTime @map("log_date") @db.Date
  aiSuggested Boolean  @default(false) @map("ai_suggested")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_logs")
}

model FitnessGoal {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  dailyCalories Int?     @map("daily_calories")
  proteinG      Decimal? @map("protein_g") @db.Decimal(5, 1)
  carbsG        Decimal? @map("carbs_g") @db.Decimal(5, 1)
  fatG          Decimal? @map("fat_g") @db.Decimal(5, 1)
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fitness_goals")
}

model Todo {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  title        String
  description  String?
  category     String?
  priority     Priority  @default(medium)
  isCompleted  Boolean   @default(false) @map("is_completed")
  dueDate      DateTime? @map("due_date")
  reminderAt   DateTime? @map("reminder_at")
  reminderSent Boolean   @default(false) @map("reminder_sent")
  isRecurring  Boolean   @default(false) @map("is_recurring")
  recurPattern String?   @map("recur_pattern")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("todos")
}

model ChatMessage {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  sessionId   String   @map("session_id")
  role        ChatRole
  content     String
  contextType String?  @map("context_type")
  actionTaken Boolean  @default(false) @map("action_taken")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

enum MediaType {
  photo
  audio
  video
  document
}

enum WorkoutStatus {
  planned
  completed
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum Priority {
  low
  medium
  high
}

enum ChatRole {
  user
  assistant
}

model BodyScan {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  scanDate       DateTime @map("scan_date") @db.Date
  weight         Decimal  @db.Decimal(5, 1)
  bodyFatPct     Decimal? @map("body_fat_pct") @db.Decimal(4, 1)
  muscleMassKg   Decimal? @map("muscle_mass_kg") @db.Decimal(5, 1)
  leanBodyMassKg Decimal? @map("lean_body_mass_kg") @db.Decimal(5, 1)
  bmr            Int?
  tee            Int?
  visceralFat    Int?     @map("visceral_fat")
  bwiScore       Decimal? @map("bwi_score") @db.Decimal(3, 1)
  bioAge         Int?     @map("bio_age")
  proteinKg      Decimal? @map("protein_kg") @db.Decimal(4, 1)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("body_scans")
}

model WorkoutPlan {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  name            String
  goal            String?
  fitnessLevel    String?         @map("fitness_level")
  equipment       String[]
  daysPerWeek     Int             @default(5) @map("days_per_week")
  isActive        Boolean         @default(true) @map("is_active")
  generatedByAI   Boolean         @default(false) @map("generated_by_ai")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  days            WorkoutPlanDay[]

  @@map("workout_plans")
}

model WorkoutPlanDay {
  id           String     @id @default(uuid())
  planId       String     @map("plan_id")
  dayNumber    Int        @map("day_number")
  workoutName  String?    @map("workout_name")
  muscleGroup  String?    @map("muscle_group")
  exercises    Json?
  restDay      Boolean    @default(false) @map("rest_day")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  plan         WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("workout_plan_days")
}

// ── Expense engine (personal + group / Splitwise-style) ──────────────

model Expense {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  title           String
  description     String?
  amount          Decimal  @map("amount") @db.Decimal(12, 2)
  originalAmount  Decimal  @map("original_amount") @db.Decimal(12, 2)
  currency        String
  baseAmount      Decimal  @map("base_amount") @db.Decimal(12, 2)
  baseCurrency    String   @map("base_currency")
  exchangeRate    Decimal  @map("exchange_rate") @db.Decimal(12, 6)
  category        String
  expenseDate     DateTime @map("expense_date") @db.Date
  paymentMethod   String?  @map("payment_method")
  notes           String?
  source          String   @default("MANUAL")
  paidById        String?  @map("paid_by_id")
  groupId         String?  @map("group_id")
  receiptId       String?  @unique @map("receipt_id")
  idempotencyKey  String?  @unique @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidBy          User?    @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  group           ExpenseGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  splits          ExpenseSplit[]
  receipt         Receipt? @relation("ReceiptExpense", fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([userId, expenseDate])
  @@index([groupId])
  @@map("expenses")
}

model ExpenseSplit {
  id         String   @id @default(uuid())
  expenseId  String   @map("expense_id")
  userId     String   @map("user_id")
  amount     Decimal  @db.Decimal(12, 2)
  percentage Decimal? @db.Decimal(6, 2)
  shares     Decimal? @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([userId])
  @@map("expense_splits")
}

model ExpenseGroup {
  id              String   @id @default(uuid())
  name            String
  description     String?
  createdBy       String   @map("created_by")
  defaultCurrency String   @default("INR") @map("default_currency")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  creator         User     @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members         ExpenseGroupMember[]
  expenses        Expense[]
  settlements     ExpenseSettlement[]

  @@map("expense_groups")
}

model ExpenseGroupMember {
  id       String       @id @default(uuid())
  groupId  String       @map("group_id")
  userId   String       @map("user_id")
  role     String       @default("member")
  joinedAt DateTime     @default(now()) @map("joined_at")
  group    ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("expense_group_members")
}

model ExpenseSettlement {
  id         String       @id @default(uuid())
  groupId    String       @map("group_id")
  fromUserId String       @map("from_user_id")
  toUserId   String       @map("to_user_id")
  amount     Decimal      @db.Decimal(12, 2)
  currency   String
  note       String?
  settledAt  DateTime     @default(now()) @map("settled_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  group      ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser   User         @relation("SettlementPayer", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser     User         @relation("SettlementPayee", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@map("expense_settlements")
}

model Receipt {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  expenseId        String?  @unique @map("expense_id")
  imageUrl         String   @map("image_url")
  cloudinaryId     String?  @map("cloudinary_id")
  merchant         String?
  receiptDate      DateTime? @map("receipt_date") @db.Date
  currency         String?
  subtotal         Decimal? @db.Decimal(12, 2)
  tax              Decimal? @db.Decimal(12, 2)
  tip              Decimal? @db.Decimal(12, 2)
  total            Decimal? @db.Decimal(12, 2)
  items            Json?
  rawText          String?  @map("raw_text")
  extractedData    Json?    @map("extracted_data")
  processingStatus String   @default("extracted") @map("processing_status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense          Expense? @relation("ReceiptExpense")

  @@index([userId, processingStatus])
  @@map("receipts")
}

model CurrencyRate {
  id             String   @id @default(uuid())
  baseCurrency   String   @map("base_currency")
  targetCurrency String   @map("target_currency")
  rate           Decimal  @db.Decimal(18, 8)
  source         String   @default("api")
  fetchedAt      DateTime @default(now()) @map("fetched_at")

  @@unique([baseCurrency, targetCurrency])
  @@index([fetchedAt])
  @@map("currency_rates")
}

model InAppNotification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("info")
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("in_app_notifications")
}

model PendingInvite {
  id          String   @id @default(uuid())
  inviterId   String   @map("inviter_id")
  email       String?
  phoneNumber String?  @map("phone_number")
  groupId     String?  @map("group_id")
  expenseId   String?  @map("expense_id")
  amount      Decimal? @db.Decimal(12, 2)
  status      String   @default("pending")
  token       String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  inviter User @relation("InviterUser", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phoneNumber])
  @@map("pending_invites")
}

// ── Gym Equipment & Exercise Demonstration Catalog ───────────────────

model Equipment {
  id                 String             @id @default(uuid())
  name               String             @unique
  aliases            String[]
  category           String
  description        String
  primaryMuscles     String[]           @map("primary_muscles")
  secondaryMuscles   String[]           @map("secondary_muscles")
  instructions       String[]
  setupInstructions  String[]           @map("setup_instructions")
  safetyInstructions String[]           @map("safety_instructions")
  commonMistakes     String[]           @map("common_mistakes")
  imageUrl           String?            @map("image_url")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  exercises          Exercise[]
  scanLogs           EquipmentScanLog[]

  @@map("equipment")
}

model Exercise {
  id                    String            @id @default(uuid())
  name                  String            @unique
  equipmentId           String?           @map("equipment_id")
  category              String
  difficultyLevel       String            @map("difficulty_level")
  primaryMuscle         String            @map("primary_muscle")
  secondaryMuscles      String[]          @map("secondary_muscles")
  shortDescription      String            @map("short_description")
  instructions          String[]
  startingPosition      String            @map("starting_position")
  executionTechnique    String            @map("execution_technique")
  breathingInstructions String            @map("breathing_instructions")
  commonMistakes        String[]          @map("common_mistakes")
  safetyTips            String[]          @map("safety_tips")
  recommendedSets       Int               @default(3) @map("recommended_sets")
  recommendedReps       String            @default("8-12") @map("recommended_reps")
  recommendedRestSec    Int               @default(90) @map("recommended_rest_sec")
  videoUrl              String?           @map("video_url")
  thumbnailUrl          String?           @map("thumbnail_url")
  gifUrl                String?           @map("gif_url")
  images                String[]
  tags                  String[]
  alternatives          String[]
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  equipment             Equipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  workoutExercises      WorkoutExercise[]

  @@map("exercises")
}

model EquipmentScanLog {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  equipmentId  String?    @map("equipment_id")
  detectedName String?    @map("detected_name")
  confidence   Decimal?   @db.Decimal(5, 4)
  provider     String     @default("groq")
  status       String     @default("success")
  imageHash    String?    @map("image_hash")
  cachedResult Json?      @map("cached_result")
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment    Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([imageHash])
  @@map("equipment_scan_logs")
}

