generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  passwordHash  String            @map("password_hash")
  name          String
  pinHash       String?           @map("pin_hash")
  fcmToken      String?           @map("fcm_token")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  chatHistory   ChatMessage[]
  diaryEntries  DiaryEntry[]
  fitnessGoals  FitnessGoal?
  attachments   MediaAttachment[]
  nutritionLogs NutritionLog[]
  todos         Todo[]
  workouts      Workout[]

  @@map("users")
}

model DiaryEntry {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  title       String?
  content     String
  mood        String?
  weather     String?
  entryDate   DateTime          @map("entry_date") @db.Date
  isPinned    Boolean           @default(false) @map("is_pinned")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments MediaAttachment[]

  @@map("diary_entries")
}

model MediaAttachment {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  entryId       String     @map("entry_id")
  mediaType     MediaType  @map("media_type")
  cloudinaryUrl String     @map("cloudinary_url")
  cloudinaryId  String     @map("cloudinary_id")
  fileName      String?    @map("file_name")
  fileSizeKb    Int?       @map("file_size_kb")
  durationSec   Int?       @map("duration_sec")
  createdAt     DateTime   @default(now()) @map("created_at")
  entry         DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("media_attachments")
}

model Workout {
  id                  String            @id @default(uuid())
  userId              String            @map("user_id")
  name                String
  workoutDate         DateTime          @map("workout_date") @db.Date
  status              WorkoutStatus     @default(planned)
  durationMin         Int?              @map("duration_min")
  notes               String?
  totalCaloriesBurned Int?              @map("total_calories_burned")
  createdAt           DateTime          @default(now()) @map("created_at")
  exercises           WorkoutExercise[]
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workouts")
}

model WorkoutExercise {
  id           String   @id @default(uuid())
  workoutId    String   @map("workout_id")
  exerciseName String   @map("exercise_name")
  sets         Int?
  reps         String?
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 2)
  durationSec  Int?     @map("duration_sec")
  distanceKm   Decimal? @map("distance_km") @db.Decimal(5, 2)
  orderIndex   Int      @default(0) @map("order_index")
  workout      Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@map("workout_exercises")
}

model NutritionLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  foodName    String   @map("food_name")
  mealType    MealType @map("meal_type")
  calories    Int
  proteinG    Decimal? @map("protein_g") @db.Decimal(5, 1)
  carbsG      Decimal? @map("carbs_g") @db.Decimal(5, 1)
  fatG        Decimal? @map("fat_g") @db.Decimal(5, 1)
  quantity    String?
  logDate     DateTime @map("log_date") @db.Date
  aiSuggested Boolean  @default(false) @map("ai_suggested")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_logs")
}

model FitnessGoal {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  dailyCalories Int?     @map("daily_calories")
  proteinG      Decimal? @map("protein_g") @db.Decimal(5, 1)
  carbsG        Decimal? @map("carbs_g") @db.Decimal(5, 1)
  fatG          Decimal? @map("fat_g") @db.Decimal(5, 1)
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fitness_goals")
}

model Todo {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  title        String
  description  String?
  category     String?
  priority     Priority  @default(medium)
  isCompleted  Boolean   @default(false) @map("is_completed")
  dueDate      DateTime? @map("due_date")
  reminderAt   DateTime? @map("reminder_at")
  reminderSent Boolean   @default(false) @map("reminder_sent")
  isRecurring  Boolean   @default(false) @map("is_recurring")
  recurPattern String?   @map("recur_pattern")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("todos")
}

model ChatMessage {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  sessionId   String   @map("session_id")
  role        ChatRole
  content     String
  contextType String?  @map("context_type")
  actionTaken Boolean  @default(false) @map("action_taken")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

enum MediaType {
  photo
  audio
  video
}

enum WorkoutStatus {
  planned
  completed
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum Priority {
  low
  medium
  high
}

enum ChatRole {
  user
  assistant
}
